{
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules",
      "./types"
    ],

    /* Bundler mode */
    "moduleResolution": "node",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vitest/globals"] // Added vitest/globals
  },
  "include": [
    "vite.config.ts", 
    "api/**/*.ts", 
    "src/**/*.test.ts", // Added common test file pattern
    "src/utils/brevo.test.ts" // Specifically including the problematic file for good measure
  ]
}
