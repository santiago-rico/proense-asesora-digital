# ─────────────────────────────────────────────────────────────────────────────
# Proense Asesora Digital — environment variables
# Copy to `.env` and fill in real values. In production set these in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS ───────────────────────────────────────────────────────────────
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_read_token
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# ── Brevo (transactional email) ──────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=comercial@proense.co
BREVO_SENDER_NAME="Proense Seguros"

# ── Security ─────────────────────────────────────────────────────────────────
CSRF_SECRET=your_csrf_secret

# ── Email routing ────────────────────────────────────────────────────────────
# Each form's agent notification goes to:  NOTIFICATION_EMAILS + NOTIFY_<FORM>
# (both comma-separated, merged and de-duplicated). Either side may be empty.
#
# Style A (DRY):      put shared recipients in NOTIFICATION_EMAILS, specialists
#                     in each NOTIFY_<FORM>  (the example below uses this style).
# Style B (explicit): leave NOTIFICATION_EMAILS empty and list the full set of
#                     recipients in each NOTIFY_<FORM>.
#
# Resulting routing for the example below:
#   asesoría      → lidercomercial, gestorcomercial
#   cotización    → lidercomercial, gestorcomercial
#   emisión       → lidercomercial, soporte, gestorcomercial
#   modificación  → lidercomercial, soporte
#   cancelación   → lidercomercial, soporte

# Receives every form.
NOTIFICATION_EMAILS=lidercomercial@proense.co

# Extra recipients per form (added on top of NOTIFICATION_EMAILS).
NOTIFY_ASESORIA=gestorcomercial@proense.co
NOTIFY_COTIZACION=gestorcomercial@proense.co
NOTIFY_EMISION=soporte@proense.co,gestorcomercial@proense.co
NOTIFY_MODIFICACION=soporte@proense.co
NOTIFY_CANCELACION=soporte@proense.co
